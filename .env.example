# Copy this file to .env and adjust values before running.
# CLI arguments (python main.py PORT SEED_PEER) override these.

# Number of leading zeros required in a valid block hash (higher = harder)
DIFFICULTY=3

# Host to bind to (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Default port for this node
PORT=5000

# Leave empty for a bootstrap node; set to host:port of an existing node
SEED_PEER=

# Coinbase reward issued to the miner of each block
MINING_REWARD=10.0

# Address (label or PEM public key) that receives the mining reward
MINER_ADDRESS=miner_default

# Optional: a wallet's public key file (from `python wallet.py keygen NAME`).
# If set, mining rewards go to that wallet instead of MINER_ADDRESS.
# The node needs only the .pub file; never give it the .key file.
MINER_PUBKEY_FILE=
